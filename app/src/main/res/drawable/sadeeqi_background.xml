<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#080A12"
                android:centerColor="#171426"
                android:endColor="#090B13"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="230dp"
                android:centerColor="#553D2C70"
                android:endColor="#003D2C70" />
        </shape>
    </item>
    <item
        android:width="300dp"
        android:height="300dp"
        android:gravity="bottom|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerColor="#334D3A1A"
                android:endColor="#004D3A1A" />
        </shape>
    </item>
</layer-list>
